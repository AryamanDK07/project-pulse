# ---- PostgreSQL (relational data + pgvector) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_pulse

# ---- MongoDB (SRS documents, sections, change history) ----
MONGODB_URI=mongodb://localhost:27017/project_pulse

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# ---- Embeddings (optional) ----
# Leave blank to use the built-in offline 384-d hashing embedder.
# If set, text-embedding-3-small is called with dimensions=384.
# IMPORTANT: pick ONE provider per database; vectors from different models are not comparable.
OPENAI_API_KEY=

# ---- Originality policy ----
# Cosine similarity at/above which a proposal is queued for faculty similarity review (0..1).
# Real embedding models (OpenAI): ~0.75. Built-in offline hashing embedder: ~0.30
# (it scores lower because it only matches shared wording, not meaning).
SIMILARITY_THRESHOLD=0.30
